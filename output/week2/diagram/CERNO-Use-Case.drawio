        <mxCell id="report_note" value="Laporan anonim:&#10;- tanpa akun dan tanpa public feed;&#10;- redaksi, deduplikasi, dan rate limit;&#10;- konfirmasi pengiriman / status;&#10;- laporan valid menjadi sinyal tambahan.&#10;&#10;Moderasi: accepted, rejected, duplicate,&#10;atau needs_review; awalnya pending." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#243746;strokeColor=#243746;strokeWidth=1.5;fillColor=#F3F5F7;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
