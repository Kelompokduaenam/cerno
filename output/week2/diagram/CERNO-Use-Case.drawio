        <mxCell id="account_note" value="Riwayat: login, persetujuan simpan,&#10;dan akses hanya ke data milik sendiri.&#10;Admin / moderator: wajib login&#10;dan lolos pemeriksaan role." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#243746;strokeColor=#243746;strokeWidth=1.5;fillColor=#F3F5F7;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
